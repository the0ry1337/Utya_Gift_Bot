# Required
BOT_TOKEN=your_telegram_bot_token_here

# Optional marketplace auth tokens (get from browser DevTools → Application → Local Storage)
# MRKT: Log into https://mrkt.fun, open DevTools → Network tab, find any API request → copy Authorization header
MRKT_TOKEN=

# Portals: Log into https://portals-market.com, open DevTools → Network → any request → copy Authorization header
PORTALS_TOKEN=

# Tonnel: Log into https://market.tonnel.network, open DevTools → Application → Local Storage → copy web-initData value
TONNEL_TOKEN=

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL=300
