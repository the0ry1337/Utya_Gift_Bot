# ── Required ────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ── Pyrogram (for auto token refresh) ───────────────────────────────────────
# Get these from https://my.telegram.org/apps  →  create an app
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Marketplace tokens ───────────────────────────────────────────────────────
# If Pyrogram is configured above these are refreshed automatically every 20 h.
# Otherwise fill them in manually (see README for how to extract from browser).
MRKT_TOKEN=
PORTALS_TOKEN=
TONNEL_TOKEN=

# ── Advanced ─────────────────────────────────────────────────────────────────
# MRKT mini-app short name — change only if MRKT token refresh fails
MRKT_APP_SHORT_NAME=market

# Price cache TTL in seconds (default 5 minutes)
CACHE_TTL=300
